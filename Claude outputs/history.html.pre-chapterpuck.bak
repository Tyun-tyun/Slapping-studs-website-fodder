<script src="js/hero-puck.js"></script>
<script>
/* History page behaviour: builds the eras, moves the puck.
   Scoped so nothing leaks next to the site's own globals.
   CONTENT NOTE - the `eras` list below is a placeholder. The
   requirement for this page is that the board edits it from the
   admin console without touching code, so the plan is to move it
   into js/data.js as its own collection (year, title, text, facts,
   photo, motif, gold) with a schema in js/core.js, and have this
   script read Studs data instead. Until then: edit freely here.
     photo: path to a full-bleed background image (optional).
     facts: up to 3 big numbers shown under the text (optional).
     motif: key from `motifs` - the faint era drawing behind the text.
     gold:  true for the one era that is the title - it is the only
            era whose year is set in gold. */
(function(){
"use strict";
const eras = [
  {year:'1982', title:'Founded', text:'In February 1982 a handful of students at the University of Twente found The Slapping Studs. They start out inside Enschede Lions, playing the national recreation league against Heerenveen, Leeuwarden, Groningen and Assen - Bert ten Vergert as coach, Ch\u00e9 Hsin Falkenstr\u00f6m leading on the ice.', facts:[['Feb','1982'],['5','founders'],['1987','local club folds']], photo:'', motif:'origins'},
  {year:'1990s', title:'[Chapter title]', text:'[sample placeholder — the decade the club found its name and its rivals.]', facts:[], photo:'', motif:'nineties'},
  {year:'2000s', title:'[Chapter title]', text:'[sample placeholder]', facts:[], photo:'', motif:'aughts'},
  {year:'2010s', title:'[Chapter title]', text:'[sample placeholder — a second team, then a third.]', facts:[['3','teams']], photo:'', motif:'tens'},
  {year:'2025/26', title:'Champions', text:'[sample] Striking Stallions win the North 5th Division. Team 1 finishes second, Team 2 sixth.', facts:[['1st','Stallions'],['2nd','Team 1'],['6th','Team 2']], gold:true, photo:'', motif:'trophy'},
  {year:'Today', title:'The Studs now', text:'[sample] 50+ active players, three teams, home ice at IJsbaan Twente.', facts:[['50+','players'],['44','seasons']], photo:'', motif:'now'},
];
/* ------------ era motifs (background attributes) ------------
   Each key = a faint, monochrome line drawing. An era picks one via
   `motif`. Admin side: store the key in the DB and offer this list
   as a dropdown. Add new eras here. Bone for every era, the club
   gold only for the title. */
const B = 'rgba(237,234,225,';   // bone + alpha
const G = 'rgba(247,195,37,';    // gold + alpha
const I = 'rgba(147,169,184,';   // ice + alpha
const motifs = {
  // 1982 — old rink, wooden sticks, puck, tube skate, arena bulbs
  origins: `<svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" fill="none" stroke="${B}.10)" stroke-width="2">
    <rect x="80" y="80" width="1040" height="540" rx="120" stroke="${B}.07)"/>
    <path d="M150 640 L640 150 M660 150 l14 -38 h40" stroke-width="10" stroke-linecap="round" stroke="${B}.06)"/>
    <path d="M1050 640 L560 150 M540 150 l-14 -38 h-40" stroke-width="10" stroke-linecap="round" stroke="${B}.06)"/>
    <ellipse cx="600" cy="420" rx="34" ry="12" fill="${B}.08)" stroke="none"/>
    <g stroke="${B}.09)"><path d="M900 520 h150 l20 -60 h-30 l-10 30 h-120 z"/><path d="M905 528 h140 M915 545 h120"/><circle cx="925" cy="560" r="8"/><circle cx="1030" cy="560" r="8"/></g>
    <g fill="${B}.05)" stroke="none">${Array.from({length:14},(_,i)=>`<circle cx="${140+i*68}" cy="110" r="${3+((i*7)%4)}"/>`).join('')}</g>
  </svg>`,
  // 1990s — VHS tracking bars, Memphis squiggles, cassette
  nineties: `<svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" fill="none" stroke="${B}.10)" stroke-width="2">
    <g stroke="${B}.05)" stroke-width="1">${Array.from({length:9},(_,i)=>`<line x1="0" y1="${60+i*74}" x2="1200" y2="${60+i*74}" stroke-dasharray="${40+i*30} ${90-i*6}"/>`).join('')}</g>
    <path d="M100 560 q40 -60 80 0 t80 0 t80 0 t80 0" stroke="${B}.12)" stroke-width="3"/>
    <path d="M820 120 l60 100 h-120 z" stroke="${B}.10)"/><circle cx="1010" cy="200" r="46" stroke-dasharray="6 8"/>
    <g stroke="${B}.10)"><rect x="430" y="160" width="300" height="180" rx="14"/><circle cx="510" cy="250" r="28"/><circle cx="650" cy="250" r="28"/><path d="M538 250 h84 M470 320 h220 M460 180 h240"/></g>
    <path d="M60 220 l30 -30 l30 30 l30 -30 l30 30" stroke="${B}.10)"/>
    <text x="1000" y="620" font-family="IBM Plex Mono, monospace" font-size="14" fill="${B}.10)" stroke="none" letter-spacing="4">PLAY &#9654;</text>
  </svg>`,
  // 2000s — CRT pixels, flip phone, web cursor, disc, console prompt
  aughts: `<svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" fill="none" stroke="${B}.10)" stroke-width="2">
    <g fill="${B}.045)" stroke="none">${Array.from({length:60},(_,i)=>`<rect x="${(i%12)*100+30}" y="${Math.floor(i/12)*130+40}" width="${8+((i*5)%10)}" height="${8+((i*5)%10)}"/>`).join('')}</g>
    <g stroke="${B}.10)"><rect x="180" y="180" width="110" height="200" rx="18"/><rect x="200" y="200" width="70" height="60" rx="4"/><path d="M195 290 h80 M195 315 h80 M195 340 h80"/><path d="M180 380 l-8 120 h126 l-8 -120"/></g>
    <circle cx="960" cy="260" r="90" stroke="${B}.09)"/><circle cx="960" cy="260" r="18" stroke="${B}.09)"/><circle cx="960" cy="260" r="60" stroke="${B}.05)" stroke-dasharray="2 6"/>
    <path d="M620 470 v90 l22 -18 l16 34 l14 -7 l-16 -34 h28 z" fill="${B}.10)" stroke="none"/>
    <text x="80" y="640" font-family="IBM Plex Mono, monospace" font-size="16" fill="${B}.09)" stroke="none">C:\\&gt; _</text>
  </svg>`,
  // 2010s — smartphone, chat bubble, hashtag, heart, notification dots
  tens: `<svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" fill="none" stroke="${B}.10)" stroke-width="2">
    <g stroke="${B}.10)"><rect x="140" y="150" width="150" height="300" rx="24"/><rect x="160" y="190" width="110" height="200" rx="6"/><circle cx="215" cy="425" r="10"/></g>
    <g stroke="${B}.09)"><path d="M820 160 h220 a24 24 0 0 1 24 24 v80 a24 24 0 0 1 -24 24 h-160 l-40 34 v-34 h-20 a24 24 0 0 1 -24 -24 v-80 a24 24 0 0 1 24 -24z"/><path d="M850 210 h160 M850 240 h110"/></g>
    <path d="M508 350 h60 M504 372 h60 M520 340 l-6 46 M552 340 l-6 46" stroke="${B}.10)" stroke-width="4" stroke-linecap="round"/>
    <path d="M400 560 c-40 -60 40 -90 60 -40 c20 -50 100 -20 60 40 l-60 60 z" stroke="${B}.09)"/>
    <g fill="${B}.05)" stroke="none">${Array.from({length:16},(_,i)=>`<circle cx="${1000+((i*37)%150)}" cy="${420+((i*53)%220)}" r="3"/>`).join('')}</g>
  </svg>`,
  // championship — cup, laurel, confetti (gold)
  trophy: `<svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" fill="none" stroke="${G}.14)" stroke-width="2">
    <g transform="translate(860 120)"><path d="M0 0 h220 v70 c0 90 -50 140 -110 150 c-60 -10 -110 -60 -110 -150z"/><path d="M0 30 h-40 a40 40 0 0 0 40 60 M220 30 h40 a40 40 0 0 1 -40 60"/><path d="M85 220 h50 v40 h-50z M60 260 h100"/></g>
    <g stroke="${G}.10)"><path d="M140 620 q120 -240 340 -260 M140 620 q0 -60 60 -40 M190 540 q-10 -60 50 -50 M260 450 q-10 -60 60 -40 M350 390 q0 -60 60 -30"/></g>
    <g fill="${G}.12)" stroke="none">${Array.from({length:40},(_,i)=>{const x=(i*173)%1180,y=(i*97)%680;return `<rect x="${x}" y="${y}" width="6" height="12" transform="rotate(${(i*47)%360} ${x} ${y})"/>`;}).join('')}</g>
  </svg>`,
  // today — rink markings: the zone lines in gold, the centre line in ice
  now: `<svg viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" fill="none" stroke-width="2">
    <line x1="420" y1="0" x2="420" y2="700" stroke="${G}.14)" stroke-width="8"/>
    <line x1="780" y1="0" x2="780" y2="700" stroke="${G}.14)" stroke-width="8"/>
    <line x1="600" y1="0" x2="600" y2="700" stroke="${I}.22)" stroke-width="3" stroke-dasharray="14 10"/>
    <circle cx="600" cy="350" r="150" stroke="${G}.14)"/><circle cx="600" cy="350" r="6" fill="${I}.3)"/>
  </svg>`,
};
/* ------------ build ------------ */
const n = eras.length;
const $ = id => document.getElementById(id);
$('hicn').textContent = n;
$('hitrack').style.height = (n * 100 + 60) + 'vh';
eras.forEach((c,i) => {
  const el = document.createElement('article');
  el.className = 'hi-era' + (c.gold ? ' gold' : '');
  el.innerHTML = `
    <p class="eyebrow">Chapter ${String(i+1).padStart(2,'0')}</p>
    <div class="disp year">${c.year.replace(/^(\d+)s$/i, '$1<span class="yr-s">s</span>')}</div>
    <h2 class="disp title">${c.title}</h2>
    <p class="body text">${c.text}</p>
    ${c.facts.length ? `<div class="facts">${c.facts.map(f=>`<div><b>${f[0]}</b><span>${f[1]}</span></div>`).join('')}</div>` : ''}
    <div class="ph" data-ph="Photo &middot; ${c.year}"></div>`;
  $('hieras').appendChild(el);
  const m = document.createElement('div');
  m.className = 'hi-motif'; m.innerHTML = motifs[c.motif] || '';
  $('himotifs').appendChild(m);
  const bg = document.createElement('div');
  bg.className = 'hi-bg';
  if (c.photo) bg.style.backgroundImage = `url(${c.photo})`;
  $('hibgs').appendChild(bg);
  const mark = document.createElement('div');
  mark.className = 'mark';
  mark.style.left = (i/(n-1))*100 + '%';
  $('himarks').appendChild(mark);
  const lab = document.createElement('div');
  lab.textContent = c.year; lab.style.left = (i/(n-1))*100 + '%';
  $('hilabels').appendChild(lab);
});
const eraEls = [...document.querySelectorAll('.hi-era')], mEls = [...document.querySelectorAll('.hi-motif')], bgEls = [...document.querySelectorAll('.hi-bg')],
      markEls = [...$('himarks').children], labEls = [...$('hilabels').children];
let current = -1;
function render(p){
  const idx = Math.min(n-1, Math.floor(p * n));
  $('hifill').style.width = p*100 + '%';
  $('hipuck').style.left = p*100 + '%';
  if (idx === current) return;
  current = idx;
  const c = eras[idx];
  eraEls.forEach((e,i)=>e.classList.toggle('on', i===idx));
  mEls.forEach((e,i)=>e.classList.toggle('on', i===idx));
  bgEls.forEach((e,i)=>e.classList.toggle('on', i===idx && !!c.photo));
  markEls.forEach((e,i)=>e.classList.toggle('past', i<=idx));
  labEls.forEach((e,i)=>e.classList.toggle('on', i===idx));
  $('hici').textContent = idx+1;
}
function onScroll(){
  const r = $('hitrack').getBoundingClientRect();
  const total = $('hitrack').offsetHeight - window.innerHeight;
  render(Math.max(0, Math.min(.9999, total>0 ? -r.top/total : 0)));
}
addEventListener('scroll', onScroll, {passive:true});
addEventListener('resize', onScroll);
onScroll();
})();
</script>
</body>
</html>
