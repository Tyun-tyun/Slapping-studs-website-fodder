@media (prefers-reduced-motion:reduce){.hp .hp-cam,.hp .hp-dropper,.hp .hp-puck,.hp .hp-face,.hp .hp-rg,.hp .hp-pn,.hp .hp-sh,.hp .hp-rpl,.hp .hp-shk,.hp .hp-fl{animation:none!important}}
/* scroll-driven: the hero is pinned inside a tall track and the
   animation is scrubbed by scroll position (js/hero-puck.js). Sized with transform (not width) so its edges anti-alias exactly like the hero's stroked line instead of snapping to whole pixels. */
.hp-track{position:relative;height:360svh}
.hp-track .hi-hero{position:sticky;top:0;height:calc(100svh - var(--adminbar-h,0px));min-height:0}
@media (prefers-reduced-motion:reduce){.hp-track{height:auto}.hp-track .hi-hero{position:relative;height:auto;min-height:calc(100svh - var(--adminbar-h,0px))}}
/* the hero's centre line, carried into the chapter stage: same width
   and position as the zoomed-in line at the end of the animation
   (4px stroke x 1.0993 rink zoom x 12.5; the centre line sits 0.5px
   right of the scene centre, x12.5). It stays attached to the page
   (js/hero-puck.js scrolls it up with the content) and dissolves
   downwards: full strength at the seam, gone by the middle of the screen.
   Sized with transform (not width) so its edges anti-alias exactly
   like the hero's stroked line instead of snapping to whole pixels. */
.hi-spine{position:absolute;left:50%;top:0;bottom:0;width:100px;margin-left:-50px;transform:translateX(calc(6.25px * var(--hp-s,1))) scaleX(calc(.55 * var(--hp-s,1)));background:rgba(147,169,184,.3);z-index:-1;pointer-events:none;opacity:0;
  -webkit-mask-image:linear-gradient(180deg,#000 0,rgba(0,0,0,.8) 10%,rgba(0,0,0,.5) 21%,rgba(0,0,0,.22) 32%,rgba(0,0,0,.06) 42%,transparent 50%);
  mask-image:linear-gradient(180deg,#000 0,rgba(0,0,0,.8) 10%,rgba(0,0,0,.5) 21%,rgba(0,0,0,.22) 32%,rgba(0,0,0,.06) 42%,transparent 50%)}
