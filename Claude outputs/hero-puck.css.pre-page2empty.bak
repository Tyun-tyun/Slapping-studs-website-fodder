/* hero-puck.css - the History hero: the rink's centre-circle spins into
   a puck, the camera pushes in, a shockwave runs through the markings,
   it lands on 1982 (LED dots), shrinks 30%, then glides up
   to the top while its shadow follows and the centre line fades out below it. Generated from the approved canvas
   board "Shadow 2 - puck 30% smaller" (PuckFall + shadow + glide). Everything is prefixed hp- so nothing leaks into the
   shared sheets. Geometry is a fixed 1440x900 scene, scaled to the
   hero by js/hero-puck.js (--hp-s). The animation is scrubbed by
   scroll, not played by time. */
.hp{position:absolute;inset:0;overflow:hidden;z-index:0;background:#111417}
.hp svg text{text-rendering:geometricPrecision}
.hp-scene{position:absolute;left:50%;top:50%;width:1440px;height:900px;margin:-450px 0 0 -720px;transform:scale(var(--hp-s,1));transform-origin:50% 50%}
.hp-cam{position:absolute;left:0;top:0;width:1440px;height:900px;transform-origin:720px 450px}
.hp-bw{position:absolute;left:0;top:0;width:1440px;height:900px}
.hp-stage{position:absolute;left:562px;top:292px;width:316px;height:316px}
.hp-dropper,.hp-puck{position:absolute;left:0;top:0;width:316px;height:316px}
.hp-dropper{perspective:1100px}
.hp-puck{transform-style:preserve-3d}
.hp-face{position:absolute;left:0;top:0;width:316px;height:316px;border-radius:50%;background-color:#15181b;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.hp-front{transform:translateZ(50px)}
.hp-back{transform:translateZ(-50px) rotateX(180deg) translateZ(50px)}
.hp-pn{position:absolute;left:149.5px;top:108px;width:17px;height:100px;display:block;backface-visibility:hidden;-webkit-backface-visibility:hidden;background-color:#15181b;background-image:linear-gradient(180deg,rgba(247,195,37,.7) 0,rgba(247,195,37,.7) 3px,transparent 3px,transparent calc(100% - 3px),rgba(247,195,37,.7) calc(100% - 3px));box-shadow:inset 1px 0 0 rgba(237,234,225,.16)}
.hp-sh{position:absolute;left:562px;top:292px;width:316px;height:316px;border-radius:50%;background:radial-gradient(circle,rgba(0,0,0,.92) 0,rgba(0,0,0,.92) 58%,rgba(0,0,0,0) 100%)}
.hp-rpl{position:absolute;left:0;top:0;width:1440px;height:900px;-webkit-mask-image:radial-gradient(circle closest-side,transparent 50%,#000 76%,transparent 100%);mask-image:radial-gradient(circle closest-side,transparent 50%,#000 76%,transparent 100%);-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-position:center;mask-position:center;pointer-events:none}
.hp-shk{position:absolute;left:562px;top:292px;width:316px;height:316px;box-sizing:border-box;border-radius:50%;border:2.4px solid #F7C325;opacity:0;pointer-events:none}
.hp-fl{position:absolute;left:0;top:0;width:1440px;height:900px;background:radial-gradient(circle at 50% 50%,rgba(247,195,37,.55) 0,rgba(247,195,37,.15) 22%,rgba(247,195,37,0) 48%);pointer-events:none}
.hp-cam{transform:translate(0px,0px) rotate(0deg) scale(12.5) translate(0px,0px)}
.hp-dropper{transform:translate(0px,0px) scale(1)}
.hp-puck{transform:translateZ(-50px) rotateX(1080deg)}
.hp-face{background-color:rgba(21,24,27,1)}
.hp-rg{opacity:1}
.hp-pn{opacity:1}
.hp-sh{transform:translate(0px,0px) scale(0.108);opacity:0.5342}
.hp-rpl{-webkit-mask-size:2802px 2802px;mask-size:2802px 2802px;opacity:0}
.hp-shk{transform:scale(4.4804);opacity:0}
.hp-fl{opacity:0}
.hp .hp-cam{animation:hpS 6.4s linear both}
.hp .hp-dropper{animation:hpD 6.4s linear both}
.hp .hp-puck{animation:hpU 6.4s linear both}
.hp .hp-face{animation:hpF 6.4s linear both}
.hp .hp-rg{animation:hpR 6.4s linear both}
.hp .hp-pn{animation:hpN 6.4s linear both}
.hp .hp-sh{animation:hpH 6.4s linear both}
.hp .hp-rpl{animation:hpX0 6.4s linear both}
.hp .hp-shk{animation:hpX1 6.4s linear both}
.hp .hp-fl{animation:hpX2 6.4s linear both}
@keyframes hpS{0.0000%{transform:translate(0px,0px) rotate(0deg) scale(1) translate(0px,0px)}1.6666%{transform:translate(0px,0px) rotate(0deg) scale(1.0017) translate(0px,0px)}3.3333%{transform:translate(0px,0px) rotate(0deg) scale(1.0067) translate(0px,0px)}5.0000%{transform:translate(0px,0px) rotate(0deg) scale(1.0152) translate(0px,0px)}6.6667%{transform:translate(0px,0px) rotate(0deg) scale(1.0273) translate(0px,0px)}8.3333%{transform:translate(0px,0px) rotate(0deg) scale(1.043) translate(0px,0px)}10.0000%{transform:translate(0px,0px) rotate(0deg) scale(1.0627) translate(0px,0px)}11.6667%{transform:translate(0px,0px) rotate(0deg) scale(1.0867) translate(0px,0px)}13.3332%{transform:translate(0px,0px) rotate(0deg) scale(1.1152) translate(0px,0px)}15.0000%{transform:translate(0px,0px) rotate(0deg) scale(1.1489) translate(0px,0px)}16.6666%{transform:translate(0px,0px) rotate(0deg) scale(1.1881) translate(0px,0px)}18.3333%{transform:translate(0px,0px) rotate(0deg) scale(1.2338) translate(0px,0px)}20.0001%{transform:translate(0px,0px) rotate(0deg) scale(1.2868) translate(0px,0px)}21.6667%{transform:translate(0px,0px) rotate(0deg) scale(1.3483) translate(0px,0px)}23.3333%{transform:translate(0px,0px) rotate(0deg) scale(1.4198) translate(0px,0px)}25.0000%{transform:translate(0px,0px) rotate(0deg) scale(1.5035) translate(0px,0px)}26.6667%{transform:translate(0px,0px) rotate(0deg) scale(1.6021) translate(0px,0px)}28.3332%{transform:translate(0px,0px) rotate(0deg) scale(1.7197) translate(0px,0px)}30.0000%{transform:translate(0px,0px) rotate(0deg) scale(1.8624) translate(0px,0px)}30.8333%{transform:translate(0px,0px) rotate(0deg) scale(1.946) translate(0px,0px)}31.6667%{transform:translate(0px,0px) rotate(0deg) scale(2.0401) translate(0px,0px)}32.5000%{transform:translate(0px,0px) rotate(0deg) scale(2.1474) translate(0px,0px)}33.3333%{transform:translate(0px,0px) rotate(0deg) scale(2.2718) translate(0px,0px)}34.1667%{transform:translate(0px,0px) rotate(0deg) scale(2.4197) t