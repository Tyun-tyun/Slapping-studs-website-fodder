.hp-sh{background:none!important;border-radius:0!important}.hp-sh::before{content:"";position:absolute;left:41px;top:41px;width:234px;height:234px;border-radius:50%;background:#000;transform:translate(0,14px);box-shadow:0 4px 7px rgba(0,0,0,1),0 20px 44px rgba(0,0,0,.75)}@keyframes hpPZ{0.0000%{transform:scale(1.0000)}1.6666%{transform:scale(0.9998)}3.3333%{transform:scale(0.9991)}5.0000%{transform:scale(0.9979)}6.6667%{transform:scale(0.9962)}8.3333%{transform:scale(0.9941)}10.0000%{transform:scale(0.9914)}11.6667%{transform:scale(0.9883)}13.3332%{transform:scale(0.9847)}15.0000%{transform:scale(0.9806)}16.6666%{transform:scale(0.9760)}18.3333%{transform:scale(0.9708)}20.0001%{transform:scale(0.9650)}21.6667%{transform:scale(0.9587)}23.3333%{transform:scale(0.9517)}25.0000%{transform:scale(0.9440)}26.6667%{transform:scale(0.9356)}28.3332%{transform:scale(0.9263)}30.0000%{transform:scale(0.9159)}30.8333%{transform:scale(0.9103)}31.6667%{transform:scale(0.9042)}32.5000%{transform:scale(0.8977)}33.3333%{transform:scale(0.8906)}34.1667%{transform:scale(0.8827)}34.5833%{transform:scale(0.8783)}34.9999%{transform:scale(0.8736)}35.4167%{transform:scale(0.8684)}35.8333%{transform:scale(0.8625)}36.2499%{transform:scale(0.8563)}36.6667%{transform:scale(0.8509)}37.0833%{transform:scale(0.8464)}37.4999%{transform:scale(0.8426)}38.3333%{transform:scale(0.8359)}38.7500%{transform:scale(0.8324)}39.1667%{transform:scale(0.8288)}39.5833%{transform:scale(0.8248)}40.0000%{transform:scale(0.8207)}40.8332%{transform:scale(0.8122)}41.6667%{transform:scale(0.8042)}43.3332%{transform:scale(0.7904)}45.0000%{transform:scale(0.7781)}46.6667%{transform:scale(0.7671)}47.5000%{transform:scale(0.7622)}48.3333%{transform:scale(0.7576)}49.9999%{transform:scale(0.7495)}50.8333%{transform:scale(0.7458)}51.6667%{transform:scale(0.7425)}52.5000%{transform:scale(0.7393)}53.3333%{transform:scale(0.7364)}54.1667%{transform:scale(0.7337)}55.0000%{transform:scale(0.7311)}55.8332%{transform:scale(0.7288)}56.6666%{transform:scale(0.7266)}57.5000%{transform:scale(0.7245)}58.3333%{transform:scale(0.7226)}59.1666%{transform:scale(0.7209)}60.0000%{transform:scale(0.7192)}60.8333%{transform:scale(0.7176)}61.6667%{transform:scale(0.7162)}63.3333%{transform:scale(0.7136)}64.9999%{transform:scale(0.7113)}66.6667%{transform:scale(0.7093)}68.3332%{transform:scale(0.7076)}70.0000%{transform:scale(0.7061)}71.6666%{transform:scale(0.7048)}73.3333%{transform:scale(0.7038)}75.0000%{transform:scale(0.7028)}76.6667%{transform:scale(0.7021)}78.3333%{transform:scale(0.7014)}79.9999%{transform:scale(0.7009)}81.6667%{transform:scale(0.7006)}83.3332%{transform:scale(0.7003)}85.0000%{transform:scale(0.7001)}86.6666%{transform:scale(0.7000)}88.3333%{transform:scale(0.7000)}89.9999%{transform:scale(0.7000)}91.6667%{transform:scale(0.7000)}93.3333%{transform:scale(0.7000)}95.0000%{transform:scale(0.7000)}96.6667%{transform:scale(0.7000)}98.3332%{transform:scale(0.7000)}100.0000%{transform:scale(0.7000)}}.hp-pz,.hp-pzs{position:absolute;left:0;top:0;width:1440px;height:900px;transform-origin:720px 450px;pointer-events:none;transform:scale(0.7)}
.hp .hp-pz,.hp .hp-pzs{animation:hpPZ 6.4s linear both}
@media (prefers-reduced-motion:reduce){.hp-pz,.hp-pzs{animation:none!important}}
@keyframes hpPG{0%{transform:translateY(0)}100%{transform:translateY(-275.75px)}}@keyframes hpPGS{0%{transform:translateY(0)}100%{transform:translateY(-22.06px)}}.hp-pg,.hp-pgs{position:absolute;left:0;top:0;width:1440px;height:900px;pointer-events:none}
.hp-pg{transform:translateY(-275.75px)}.hp-pgs{transform:translateY(-22.06px)}
.hp .hp-pg{animation:hpPG 1.3s cubic-bezier(.65,0,.35,1) 6.6s both}.hp .hp-pgs{animation:hpPGS 1.3s cubic-bezier(.65,0,.35,1) 6.6s both}
@media (prefers-reduced-motion:reduce){.hp-pg,.hp-pgs{animation:none!important}}
@keyframes hpLF{0%{opacity:0}100%{opacity:1}}.hp-lf{position:absolute;left:0;top:290px;width:1440px;height:610px;pointer-events:none;background:linear-gradient(180deg,rgba(22,25,27,0) 0,rgba(22,25,27,.55) 9%,rgba(22,25,27,1) 22%,rgba(22,25,27,1) 100%)}
.hp .hp-lf{animation:hpLF 1.3s cubic-bezier(.65,0,.35,1) 6.6s both}
@media (prefers-reduced-motion:reduce){.hp-lf{animation:none!important}}
/* scroll-driven: the hero is pinned inside a tall track and the
   animation is scrubbed by scroll position (js/hero-puck.js). Sized with transform (not width) so its edges anti-alias exactly like the hero's stroked line instead of snapping to whole pixels. */
.hp-track{position:relative;height:420svh}
.hp-track .hi-hero{position:sticky;top:0;height:calc(100svh - var(--adminbar-h,0px));min-height:0}
@media (prefers-reduced-motion:reduce){.hp-track{height:auto}.hp-track .hi-hero{position:relative;height:auto;min-height:calc(100svh - var(--adminbar-h,0px))}}
/* the hero's centre line, carried into the chapter stage: same width
   and position as the zoomed-in line at the end of the animation
   (4px stroke x 1.0993 rink zoom x 12.5; the centre line sits 0.5px
   right of the scene centre, x12.5). It stays attached to the page
   (js/hero-puck.js scrolls it up with the content) and dissolves
   downwards: full strength at the seam, gone by the middle of the screen.
   Sized with transform (not width) so its edges anti-alias exactly
   like the hero's stroked line instead of snapping to whole pixels. */
.hi-spine{position:absolute;left:50%;top:0;bottom:0;width:100px;margin-left:-50px;transform:translateX(calc(6.25px * var(--hp-s,1))) scaleX(calc(.55 * var(--hp-s,1)));background:rgba(147,169,184,.3);z-index:-1;pointer-events:none;opacity:0;
  -webkit-mask-image:linear-gradient(180deg,#000 0,rgba(0,0,0,.8) 10%,rgba(0,0,0,.5) 21%,rgba(0,0,0,.22) 32%,rgba(0,0,0,.06) 42%,transparent 50%);
  mask-image:linear-gradient(180deg,#000 0,rgba(0,0,0,.8) 10%,rgba(0,0,0,.5) 21%,rgba(0,0,0,.22) 32%,rgba(0,0,0,.06) 42%,transparent 50%)}
