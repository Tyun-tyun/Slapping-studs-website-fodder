e(8.4899) translate(0px,0px)}53.3333%{transform:translate(0px,0px) rotate(0deg) scale(8.7312) translate(0px,0px)}54.1667%{transform:translate(0px,0px) rotate(0deg) scale(8.9626) translate(0px,0px)}55.0000%{transform:translate(0px,0px) rotate(0deg) scale(9.1843) translate(0px,0px)}55.8332%{transform:translate(0px,0px) rotate(0deg) scale(9.3966) translate(0px,0px)}56.6666%{transform:translate(0px,0px) rotate(0deg) scale(9.5995) translate(0px,0px)}57.5000%{transform:translate(0px,0px) rotate(0deg) scale(9.7931) translate(0px,0px)}58.3333%{transform:translate(0px,0px) rotate(0deg) scale(9.9776) translate(0px,0px)}59.1666%{transform:translate(0px,0px) rotate(0deg) scale(10.1533) translate(0px,0px)}60.0000%{transform:translate(0px,0px) rotate(0deg) scale(10.3204) translate(0px,0px)}60.8333%{transform:translate(0px,0px) rotate(0deg) scale(10.4793) translate(0px,0px)}61.6667%{transform:translate(0px,0px) rotate(0deg) scale(10.6302) translate(0px,0px)}63.3333%{transform:translate(0px,0px) rotate(0deg) scale(10.909) translate(0px,0px)}64.9999%{transform:translate(0px,0px) rotate(0deg) scale(11.1586) translate(0px,0px)}66.6667%{transform:translate(0px,0px) rotate(0deg) scale(11.3812) translate(0px,0px)}68.3332%{transform:translate(0px,0px) rotate(0deg) scale(11.5784) translate(0px,0px)}70.0000%{transform:translate(0px,0px) rotate(0deg) scale(11.7521) translate(0px,0px)}71.6666%{transform:translate(0px,0px) rotate(0deg) scale(11.9038) translate(0px,0px)}73.3333%{transform:translate(0px,0px) rotate(0deg) scale(12.0351) translate(0px,0px)}75.0000%{transform:translate(0px,0px) rotate(0deg) scale(12.1473) translate(0px,0px)}76.6667%{transform:translate(0px,0px) rotate(0deg) scale(12.2418) translate(0px,0px)}78.3333%{transform:translate(0px,0px) rotate(0deg) scale(12.3198) translate(0px,0px)}79.9999%{transform:translate(0px,0px) rotate(0deg) scale(12.3824) translate(0px,0px)}81.6667%{transform:translate(0px,0px) rotate(0deg) scale(12.4306) translate(0px,0px)}83.3332%{transform:trans